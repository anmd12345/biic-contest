                    <div class="row g-1 g-sm-2 mb-7 mb-xxl-8">
                        <div class="col-12 col-xl-12 col-xxl-12">
                            <div class="card h-100">
                                <div class="card-body">
                                    @Html.Raw(contest.Rule)
                                </div>
                            </div>
                        </div>
                    </div>

                    @*Lịch trình sự kiện ở đây*@
                    <h3 class="mb-3 fw-bold text-body-highlight fs-xxl-6">Lịch trình sự kiện</h3>
                    <div class="row g-1 g-sm-2 mb-7 mb-xxl-8">
                        <div class="col-12 col-xl-12 col-xxl-12">
                            <div class="card h-100">
                                <div class="card-body">
                                    @Html.Raw(contest.Schedule)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @*Giải thưởng ở đây*@
            <h3 class="mb-3 fw-bold text-body-highlight fs-xxl-6">Giải thưởng</h3>
            <div class="row g-1 g-sm-2 mb-7 mb-xxl-8">
                <div class="col-12 col-xl-12 col-xxl-12">
                    <div class="card h-100">
                        <div class="card-body">
                            @Html.Raw(contest.Prize)
                        </div>
                    </div>
                </div>
            </div>

            @*Đơn vị đồng hành ở đây*@
