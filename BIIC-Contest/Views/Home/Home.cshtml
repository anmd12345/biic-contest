                    <div class="row g-1 g-sm-2 mb-7 mb-xxl-8">
                        <div class="col-12 col-xl-12 col-xxl-12">
                            <div class="card h-100">
                                <div class="card-body">
                                    <ul class="ps-4">
                                        @foreach (var item in j)
                                        {
                                            <li>@item.CriteriaName (@item.Score điểm)</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>


                    @*Thể lệ cuộc thi ở đây*@
