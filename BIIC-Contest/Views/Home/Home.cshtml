@{
    ViewBag.Title = "CUỘC THI Ý TƯỞNG KHỞI NGHIỆP SÁNG TẠO TỈNH BÌNH DƯƠNG NĂM 2024";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var contest = ViewBag.contest;
    List<dynamic> j = new List<dynamic>();

    string[] criterias = contest.Criterias.Split('|');

    foreach (var item in criterias)
    {
        string[] criteria = item.Split('-');
        j.Add(new
        {
            CriteriaName = criteria[0],
            Score = criteria[1]
        });
    }



}

@section styles{
    <link href="~/vendors/choices/choices.min.css" rel="stylesheet">
    <link href="~/vendors/glightbox/glightbox.min.css" rel="stylesheet">
    <link href="~/vendors/mapbox-gl/mapbox-gl.css" rel="stylesheet">
    <link href="~/vendors/flatpickr/flatpickr.min.css" rel="stylesheet" />
    <link href="~/vendors/dropzone/dropzone.css" rel="stylesheet" />
    <link href="~/vendors/marquee/marqueeLogo.css" rel="stylesheet" />
}


<div class="content pt-4 overflow-x-hidden">
    @if (contest == null)
    {

    }
    else
    {
        <div class="pb-3">
            <img class="rounded w-100 object-fit-fill mb-5 mb-md-6 mb-xl-8" style="max-height: 500px;min-height: 250px;" src="@contest.BannerUrl" alt="" />
            <div class="row gx-lg-12">
                <div class="col-xl-12">
                    <div class="card mb-9">
                        <div class="card-body">
                            <h1 class="lh-sm fs-7 fs-xxl-4 mb-2">@contest.Title</h1>
                            <p class="fs-8 mb-4 text-body-tertiary">Đơn vị tổ chức: Sở Khoa học và Công nghệ, Sở Giáo dục và Đào tạo, Tỉnh Đoàn Bình Dương</p>
                            <div class="card mb-5 mb-xxl-7">
                                <div class="card-body">
                                    <div class="row gy-5">
                                        <div class="col-md-6 d-flex justify-content-between">
                                            <div>
                                                <div class="mb-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="px-2 py-1 bg-info-subtle rounded"><span class="text-info" data-feather="map-pin"></span></div>
                                                        <h5 class="ms-2 text-body-emphasis mb-0">Địa điểm</h5>
                                                    </div>
                                                </div>
                                                <p class="lh-sm mb-0 text-body-tertiary">Tầng 11, Tháp A, Trung tâm Hành chính tỉnh Bình Dương</p>
                                            </div>
                                            <div class="my-4 mx-3 border-start border-translucent d-none d-md-block"></div>
                                        </div>
                                        <div class="col-md-6">
