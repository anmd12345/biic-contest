                                                    <h5 class="ms-2 mb-0">Thời gian</h5>
                                                </div>
                                            </div>
                                            <p class="lh-sm mb-0 text-body-tertiary">13/03/2025 - 17/03/2025</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-md-auto flex-md-grow-1">
                                    <button class="btn btn-primary w-100" type="button" data-bs-toggle="modal" data-bs-target="#kanbanAddTask">Đăng Ký Tham Gia</button>
                                </div>
                                <div class="col-4 col-sm-auto flex-sm-grow-1 flex-md-grow-0">
                                    <button class="btn btn-phoenix-primary w-100" type="button">
                                        <span class="fa-solid fa-eye me-2"></span>1233
                                    </button>
                                </div>
                                <div class="col-4 col-sm-auto">
                                    <button class="btn btn-phoenix-primary w-100" type="button">
                                        <span class="fa-solid fa-heart me-2"></span>3677
                                    </button>
                                </div>
                                <div class="col-4 col-sm-auto">
                                    <button class="btn btn-phoenix-primary w-100" type="button">
                                        <span class="fa-solid fa-share-nodes me-2"></span>4467
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*Giới thiệu về sự kiện ở đây*@
                    <h2 class="mb-3">Giới thiệu về sự kiện</h2>
                    <div class="row g-1 g-sm-2 mb-7 mb-xxl-8">
                        <div class="col-12 col-xl-12 col-xxl-12">
                            <div class="card h-100">
                                <div class="card-body">
                                    @Html.Raw(contest.Content)
                                </div>
                            </div>
                        </div>
                    </div>

                    @*Đối tượng tham gia ở đây*@
